  "description": "Weather web app built with Node.js, Express and Handlebars (city -> coordinates -> current weather)",
  "main": "src/app.js",
  "scripts": {
    "start": "node --env-file=.env src/app.js",
    "dev": "node --watch --env-file=.env src/app.js",
