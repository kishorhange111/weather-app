{
  "name": "weather-app",
  "version": "1.0.0",
  "description": "Weather web app built with Node.js, Express and Handlebars (city -> coordinates -> current weather)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.6"
  },
  "keywords": [
    "nodejs",
    "express",
    "handlebars",
    "weather",
    "api"
  ],
  "author": "Kishor Hange",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "hbs": "^4.4.0",
    "postman-request": "^2.88.1-postman.52"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
