# Copy this file to .env and fill in your own keys (.env is git-ignored).
# Weatherstack: https://weatherstack.com/  (current weather)
WEATHERSTACK_API_KEY=your_weatherstack_key
# OpenWeatherMap: https://openweathermap.org/api/geocoding-api  (city -> coordinates)
OPENWEATHER_API_KEY=your_openweathermap_key
PORT=4000
